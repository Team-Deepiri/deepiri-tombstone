# deepiri-tombstone environment configuration

# Ollama connection
DEEPIRI_TOMBSTONE_HOST=127.0.0.1:11434
DEEPIRI_TOMBSTONE_MODEL=llama3.2

# Output mode (text, json, jsonl, markdown)
DEEPIRI_TOMBSTONE_OUTPUT=text

# Log level (debug, info, warn, error)
DEEPIRI_TOMBSTONE_LOG=info

# Retry configuration
DEEPIRI_TOMBSTONE_RETRIES=3
DEEPIRI_TOMBSTONE_TIMEOUT=120

# Reports directory
DEEPIRI_TOMBSTONE_REPORTS_DIR=reports

# Default fixture
DEEPIRI_TOMBSTONE_FIXTURE=fixtures/eval_prompts.txt
