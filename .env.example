# deepiri-tombstone environment configuration

# Ollama connection
DEEPIRI_TOMBSTONE_HOST=127.0.0.1:11434
DEEPIRI_TOMBSTONE_MODEL=llama3.2

# Parallelism (eval / runner / bench)
# Parallel workers (unset = adaptive 4–16 via runner default_jobs)
# DEEPIRI_TOMBSTONE_JOBS=8

# Response cache (shared by Python stages + classic B bridge)
DEEPIRI_TOMBSTONE_CACHE_DIR=reports/cache
# DEEPIRI_TOMBSTONE_NO_CACHE=1

# Pin model in VRAM between calls (Ollama keep_alive)
# DEEPIRI_TOMBSTONE_KEEP_ALIVE=30m

# Hot path + classic B: stop after N failures (0 = disabled)
# DEEPIRI_TOMBSTONE_FAIL_FAST=3

# Output mode (text, json, jsonl, markdown)
DEEPIRI_TOMBSTONE_OUTPUT=text

# Log level (debug, info, warn, error)
DEEPIRI_TOMBSTONE_LOG=info

# Retry configuration
DEEPIRI_TOMBSTONE_RETRIES=3
DEEPIRI_TOMBSTONE_TIMEOUT=120

# Reports directory
DEEPIRI_TOMBSTONE_REPORTS_DIR=reports

# Default fixture
DEEPIRI_TOMBSTONE_FIXTURE=fixtures/eval_prompts.txt
